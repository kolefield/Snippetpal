<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Snippetpal" Manufacturer="Snippetpal" Version="$(var.AppVersion)" UpgradeCode="C6E908A6-B906-4118-82F9-74477E0847F4" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Snippetpal is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(var.SourceRoot)\src\Snippetpal\Assets\Snippetpal.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="Programs" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Snippetpal">
          <Component Id="Application" Guid="B1451273-0935-4F80-BDF3-C86BB98B40FC">
            <File Id="SnippetpalExe" Source="$(var.PublishDir)\Snippetpal.exe" />
            <File Id="Readme" Source="$(var.PublishDir)\README.md" />
            <File Id="Notices" Source="$(var.PublishDir)\THIRD-PARTY-NOTICES.md" />
            <RegistryValue Root="HKCU" Key="Software\Snippetpal\Installer" Name="Version" Type="string" Value="$(var.AppVersion)" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          </Component>
          <Directory Id="NoticesFolder" Name="notices">
            <Component Id="RuntimeNotices" Guid="1D8E1666-C504-4F45-99A5-67FE823035EF">
              <File Source="$(var.PublishDir)\notices\microsoft.netcore.app.runtime.win-x64-LICENSE.TXT" />
              <File Source="$(var.PublishDir)\notices\microsoft.netcore.app.runtime.win-x64-THIRD-PARTY-NOTICES.TXT" />
              <File Source="$(var.PublishDir)\notices\microsoft.windowsdesktop.app.runtime.win-x64-LICENSE.TXT" />
              <RegistryValue Root="HKCU" Key="Software\Snippetpal\Installer" Name="Notices" Type="integer" Value="1" KeyPath="yes" />
              <RemoveFolder Id="RemoveNoticesFolder" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Snippetpal">
        <Component Id="StartMenu" Guid="8DDD53B5-904B-4602-AED3-4E332D61C7CF">
          <Shortcut Id="AppShortcut" Name="Snippetpal" Target="[#SnippetpalExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Snippetpal\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Snippetpal" Level="1"><ComponentRef Id="Application"/><ComponentRef Id="StartMenu"/><ComponentRef Id="RuntimeNotices"/></Feature>
  </Package>
</Wix>
