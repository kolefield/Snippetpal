<Window x:Class="Snippetpal.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snippetpal" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Snippetpal" Style="{StaticResource {x:Type Window}}" Width="500" Height="620" MinWidth="440" MinHeight="360" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Icon="Assets/Snippetpal.ico" PreviewKeyDown="OnKeyDown" StateChanged="WindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <local:CaptureThumbnailConverter x:Key="Thumbnail"/>
    <DataTemplate DataType="{x:Type local:Snippet}">
      <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <Button HorizontalContentAlignment="Stretch" Padding="14,13" Click="CopySnippet" ToolTip="Click to copy snippet" AutomationProperties.Name="{Binding Title}">
            <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasName}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit snippet" AutomationProperties.Name="Edit snippet" Click="EditSnippet"/>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete snippet" AutomationProperties.Name="Delete snippet" Click="DeleteSnippet"/>
          <Button x:Name="ReorderHandle" Grid.Column="3" Style="{StaticResource IconButton}" Cursor="SizeAll"
                  ToolTip="Drag to reorder (Ctrl+↑ / Ctrl+↓ when focused)" AutomationProperties.Name="Reorder snippet" AutomationProperties.HelpText="Drag to move. Use Control plus Up or Down to reorder with the keyboard."
                  PreviewMouseLeftButtonDown="ReorderHandleDown" PreviewMouseMove="ReorderHandleMove" PreviewMouseLeftButtonUp="ReorderHandleUp" LostMouseCapture="ReorderHandleLostCapture" PreviewKeyDown="ReorderHandleKeyDown">
            <Path Data="M 8,1 L 8,15 M 1,8 L 15,8 M 5,4 L 8,1 11,4 M 5,12 L 8,15 11,12 M 4,5 L 1,8 4,11 M 12,5 L 15,8 12,11"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" IsHitTestVisible="False"/>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ClipboardEntry}">
      <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <Button HorizontalContentAlignment="Stretch" Padding="14,13" Click="CopyHistory" ToolTip="Click to copy text" AutomationProperties.Name="{Binding Title}"><StackPanel>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14"/>
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel></Button>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Save as snippet" AutomationProperties.Name="Save as snippet" Click="PromoteHistory"/>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from history" AutomationProperties.Name="Remove from history" Click="DeleteHistory"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CaptureEntry}">
      <Border Background="{DynamicResource GlassCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <Button HorizontalContentAlignment="Stretch" Padding="10" Click="CopyCapture" ToolTip="Click to copy image or recording file" AutomationProperties.Name="{Binding Title}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Height="62" Width="80" CornerRadius="5" Background="{DynamicResource PanelBrush}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Converter={StaticResource Thumbnail}}" Stretch="UniformToFill"/></Grid></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open capture" AutomationProperties.Name="Open capture" Click="OpenCapture"/>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from history (original file is kept)" AutomationProperties.Name="Remove capture from history" Click="DeleteCapture"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="WindowFrame" Background="{DynamicResource GlassWindowBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8">
  <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource SheenBrush}" CornerRadius="8" IsHitTestVisible="False"/>
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,9,0"><Path Data="M 5,0 L 0,0 0,14 5,14 M 11,0 L 16,0 16,14 11,14 M 8,6 L 8,8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Snippetpal" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Keep on top" AutomationProperties.Name="Keep on top" Click="TogglePin"/>
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="OpenSettings" Margin="0,0,7,0"/>
        <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,7,0"/>
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeWindow"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="MaximizeWindow"/>
        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close to tray" AutomationProperties.Name="Close window" Click="CloseWindow" Margin="0,0,5,0"/>
      </StackPanel>
    </Grid>
  <Grid Grid.Row="1" Margin="18,8,18,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12">
      <UniformGrid Columns="3"><Button x:Name="SnippetsTab" Content="Snippets" Click="SelectTab" Tag="0" Padding="8,9"/><Button x:Name="ClipboardTab" Content="Clipboard" Click="SelectTab" Tag="1" Padding="8,9"/><Button x:Name="CapturesTab" Content="Screenshots" Click="SelectTab" Tag="2" Padding="8,9"/></UniformGrid>
    </Border>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
      <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="36,11,12,11" AutomationProperties.Name="Search snippets and history"/>
      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
      <TextBlock x:Name="SearchHint" Text="Search snippets…" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
      </Grid>
      <Button Grid.Column="1" x:Name="NewButton" Content="+" Width="40" Height="40" FontSize="24" FontWeight="Normal" Padding="0" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="NewSnippet" ToolTip="New snippet (Ctrl+N)" AutomationProperties.Name="New snippet"/>
      <Button Grid.Column="1" x:Name="ClearButton" Content="&#xE74D;" Width="40" Height="40" Margin="10,0,0,0" Style="{StaticResource IconButton}" Click="ClearHistory" Visibility="Collapsed" ToolTip="Clear history" AutomationProperties.Name="Clear history"/>
    </Grid>
    <Grid Grid.Row="2">
      <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               AllowDrop="True" PreviewDragOver="SnippetDragOver" PreviewDrop="SnippetDrop" PreviewDragLeave="SnippetDragLeave">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      </ListBox>
      <Border x:Name="SnippetDropMarker" Height="2" Margin="6,0,20,0" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" CornerRadius="1" IsHitTestVisible="False" Visibility="Collapsed"/>
      <ScrollViewer x:Name="EmptyPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
      <StackPanel HorizontalAlignment="Center" Margin="16,18">
        <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center"><TextBlock x:Name="EmptyGlyph" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <TextBlock x:Name="EmptyTitle" Text="No snippets yet" FontWeight="SemiBold" FontSize="17" TextAlignment="Center" Margin="0,14,0,8"/>
        <TextBlock x:Name="EmptyDetail" Text="Add a snippet, then click it to copy." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" LineHeight="20"/>
        <Button x:Name="EmptyAction" Content="Create your first snippet" Click="NewSnippet" Margin="0,18,0,0" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border x:Name="StatusPanel" Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="11,9" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
  </Grid>
  </Grid>
  </Border>
</Window>
