<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Snippetpal.ico</ApplicationIcon>
    <Version>0.1.4</Version>
    <AssemblyTitle>Snippetpal</AssemblyTitle>
    <Product>Snippetpal</Product>
    <Description>Your snippets, clipboard, and captures. One small home.</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\Snippetpal.ico" /></ItemGroup>
</Project>
